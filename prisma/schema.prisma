// Project Approval & SLA Routing System — data model
// Postgres via Prisma. See README.md for the workflow this schema drives.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PM
  ENGINEER
}

enum Discipline {
  MECHANICAL
  FIRE_SAFETY
  ALL
}

enum ProjectStatus {
  SUBMITTED
  PM_REVIEW
  WAITING
  IN_PROGRESS
  APPROVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewPriority {
  NORMAL
  HIGH_PRIORITY
}

enum ActivityType {
  STATUS_CHANGE
  REVIEW_ROUTED
  REVIEW_DECISION
  SLA_NUDGE
  SLA_ESCALATION
  COMMENT
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  phone      String?
  role       Role
  // Which discipline this user reviews as an ENGINEER; irrelevant for PMs.
  discipline Discipline @default(ALL)

  // Per-user delivery preferences for SLA nudges/escalations and other notifications.
  notifyEmail    Boolean @default(true)
  notifyWhatsapp Boolean @default(true)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  projectsManaged  Project[]          @relation("ProjectPM")
  reviewsAssigned  DisciplineReview[] @relation("ReviewEngineer")
  magicTokens      MagicToken[]
  activityEntries  ActivityLog[]
  attachments      Attachment[]

  @@index([role, discipline])
}

model Project {
  id          String        @id @default(cuid())
  // Short, human-readable reference number (formatted as P + 6 digits by
  // lib/labels.ts) — what actually gets read aloud, typed into a search box,
  // or quoted back in an email, since nobody is going to copy a cuid.
  seq         Int           @unique @default(autoincrement())
  title       String
  description String
  status      ProjectStatus @default(SUBMITTED)
  pmId        String
  pm          User          @relation("ProjectPM", fields: [pmId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  disciplineReviews DisciplineReview[]
  magicTokens       MagicToken[]
  activityLog       ActivityLog[]
  attachments       Attachment[]

  @@index([status])
  @@index([pmId])
}

model DisciplineReview {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  discipline Discipline    // MECHANICAL | FIRE_SAFETY (ALL is not a valid review discipline)
  reviewerId String?
  reviewer   User?         @relation("ReviewEngineer", fields: [reviewerId], references: [id])

  status         ReviewStatus   @default(PENDING)
  priority       ReviewPriority @default(NORMAL)
  comments       String?

  // SLA tracking: reset whenever the review (re)enters PENDING while the
  // project is WAITING on it. The cron engine measures elapsed time from here.
  lastStatusChangeAt DateTime @default(now())
  nudge2hSent        Boolean  @default(false)
  escalation2dSent   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  magicTokens MagicToken[]

  @@index([status, discipline])
  @@index([projectId])
}

model MagicToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Optional: link straight to the discipline review this token was minted for.
  reviewId String?
  review   DisciplineReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([expiresAt])
}

// Unified project timeline: system-generated events (status changes, review
// routing, review decisions, SLA nudges/escalations) and user-posted
// comments all land here so the project detail page can render one feed.
model ActivityLog {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type    ActivityType
  message String
  // Null actor = system-generated (e.g. the SLA cron engine).
  actorId String?
  actor   User?        @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Attachment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String // relative path under the server-local uploads directory

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId])
}
