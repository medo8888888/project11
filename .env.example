# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/sla_routing?schema=public"

# Public base URL used to build magic-link deep links (no trailing slash)
APP_URL="http://localhost:3000"

# Secret used to sign session cookies — set a long random string in production
AUTH_SECRET="replace-with-a-long-random-string"

# Shared secret Vercel Cron (or your own worker) must send as
# `Authorization: Bearer <CRON_SECRET>` when hitting /api/cron/sla.
# Leave unset in local dev to allow unauthenticated calls.
CRON_SECRET=""

# Resend (email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@example.com"

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Optional: cron schedule for the standalone worker (src/worker/cron.ts)
SLA_CRON_SCHEDULE="*/5 * * * *"
