# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/sla_routing?schema=public"

# Public base URL used to build magic-link deep links (no trailing slash).
# In production this should be the domain the app is actually deployed at,
# e.g. APP_URL="https://bright.alkashafqatar.com" — every emailed/WhatsApp'd
# magic link is built from this value, so it must match the real hostname.
APP_URL="http://localhost:3000"

# Directory attachments are written to (relative or absolute). Only used by
# the local-disk attachment storage in src/lib/storage.ts — fine for a single
# instance/demo; point this at a mounted persistent volume in production, or
# swap storage.ts for S3/Vercel Blob if you run multiple instances.
UPLOAD_DIR=""

# Secret used to sign session cookies — set a long random string in production
AUTH_SECRET="replace-with-a-long-random-string"

# Shared secret Vercel Cron (or your own worker) must send as
# `Authorization: Bearer <CRON_SECRET>` when hitting /api/cron/sla.
# Leave unset in local dev to allow unauthenticated calls.
CRON_SECRET=""

# Resend (email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@example.com"

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Optional: cron schedule for the standalone worker (src/worker/cron.ts)
SLA_CRON_SCHEDULE="*/5 * * * *"
